    "tools": [
        {
            "id": "ffmpeg", "name": "FFmpeg", "kind": "cli",
            "domains": {"audio": ["process"], "video": ["cli", "transcode"]},
            "detect": {"bin": ["ffmpeg"]}, "version": ["-version"],
            "license": "LGPL-2.1+ / GPL-2+", "commercial": "yes", "cost": "free",
            "install": {"dnf": "ffmpeg-free (Fedora) or ffmpeg (RPM Fusion, with x264 / x265 / NVENC)"},
            "gpu": "optional: NVENC (NVIDIA), VAAPI (AMD / Intel)",
            "why": "the reference for any conversion, cut, filter or encode, scriptable and exact",
            "recipes": [
                ["cut without re-encoding", "ffmpeg -ss 00:01:00 -to 00:02:30 -i in.mp4 -c copy cut.mp4"],
                ["H.264 for the web", "ffmpeg -i in.mov -c:v libx264 -crf 20 -preset slow -pix_fmt yuv420p -c:a aac -b:a 192k -movflags +faststart out.mp4"],
                ["NVIDIA encode", "ffmpeg -i in.mov -c:v h264_nvenc -preset p5 -cq 21 -c:a aac out.mp4"],
                ["join clips of the same format", "printf \"file '%s'\\n\" a.mp4 b.mp4 > list.txt && ffmpeg -f concat -safe 0 -i list.txt -c copy out.mp4"],
                ["burn subtitles", "ffmpeg -i in.mp4 -vf subtitles=subs.srt -c:a copy out.mp4"],
                ["extract the audio", "ffmpeg -i in.mp4 -vn -c:a pcm_s16le audio.wav"],
                ["image sequence to video", "ffmpeg -framerate 24 -i frame_%04d.png -c:v libx264 -pix_fmt yuv420p out.mp4"],
                ["good GIF", "ffmpeg -i in.mp4 -vf \"fps=15,scale=640:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse\" out.gif"],
                ["loudness to -14 LUFS (streaming)", "ffmpeg -i in.wav -af loudnorm=I=-14:TP=-1.5:LRA=11 out.wav"],
                ["music ducked under a voice", "ffmpeg -i voice.wav -i music.wav -filter_complex \"[0:a]asplit[v1][v2];[1:a][v1]sidechaincompress=threshold=0.05:ratio=8[duck];[v2][duck]amix=inputs=2:duration=first\" mix.wav"]
            ]
        },
