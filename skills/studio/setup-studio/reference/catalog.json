            "install": {"dnf": "sox"},
            "why": "the audio Swiss knife: normalize, trim silences, resample, effects, quick synthesized beeps",
            "recipes": [
                ["normalize to -1 dB", "sox in.wav out.wav norm -1"],
                ["trim the silence at both ends", "sox in.wav out.wav silence 1 0.1 1% reverse silence 1 0.1 1% reverse"],
                ["resample to 48 kHz", "sox in.wav -r 48000 out.wav"],
                ["UI beep", "sox -n beep.wav synth 0.2 sine 880 fade 0 0.2 0.05"],
                ["spectrogram", "sox in.wav -n spectrogram -o spectrogram.png"]
