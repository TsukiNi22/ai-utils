        "head_transform": "uppercase", "head_spacing": ".04em", "head_weight": "700", "radius": "2px",
        "bgimg": "linear-gradient(#e3eaf3 1px, transparent 1px) 0 0 / 28px 28px, linear-gradient(90deg, #e3eaf3 1px, transparent 1px) 0 0 / 28px 28px",
